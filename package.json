{
  "name": "@mesub/react",
  "version": "0.0.0",
  "description": "React SDK for Mesub: sign a subscriber in and subscribe them, from the merchant's own site.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mesub-io/react-sdk.git"
  },
  "homepage": "https://github.com/Mesub-io/react-sdk#readme",
  "bugs": "https://github.com/Mesub-io/react-sdk/issues",
  "keywords": [
    "mesub",
    "solana",
    "subscriptions",
    "react",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.27.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src/ test/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:exports": "node scripts/check-exports.mjs",
    "prepare": "husky",
    "prepublishOnly": "pnpm build && pnpm check:exports"
  },
  "dependencies": {
    "@solana/kit": "^8.4.0",
    "@wallet-standard/react": "^1.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "oxlint --deny-warnings",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  }
}
